# Rock Paper Scissors Boom Configuration

# Network & Server
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# Client WebSocket URL (Empty defaults to current window.location.origin)
VITE_SERVER_URL=

# Public Production URL
PUBLIC_URL=http://localhost:3000

# Game Simulation Tuning
TICK_RATE=30
PHYSICS_SUBSTEPS=2
MAX_PLAYERS_PER_ROOM=4
MATCH_START_LIVES=3

# Rate Limiting & Abuse Protection
MAX_PACKETS_PER_SECOND=60
MAX_ROOMS_TOTAL=100

# Analytics & Monetization Flags
ENABLE_ANALYTICS=true
ENABLE_ADS=false
